# Скопируйте в .env и заполните.
# Ключ шлюза ExperientialLabs — из него берутся текстовые модели.
EXPLABS_API_KEY=
EXPLABS_BASE_URL=https://api.experientiallabs.ai/v1

# Модель для генерации курсов и подсказок. Дешёвая и быстрая.
COURSE_MODEL=deepseek-v4-flash
# Запасная, если основная недоступна.
COURSE_MODEL_FALLBACK=gpt-5.4-mini

# Пароль администратора (логин всегда maks-admin). Обязательно смените.
ADMIN_PASSWORD=codehog-admin

# Секрет для подписи сессий. В проде обязательно свой.
SECRET_KEY=change-me-in-production

# Путь к базе.
DATABASE_URL=sqlite:///./data/codehog.db

# Подкаталог, в котором открывается приложение.
# Пусто — на корне домена, codehog — на https://maks.my/codehog
BASE_PATH=codehog

# ── Смена провайдера модели ──
# Клиент говорит по стандарту OpenAI (/chat/completions + Bearer),
# поэтому переезд на другого провайдера — это три переменные, без правки кода.
#
# DeepSeek напрямую:
#   EXPLABS_BASE_URL=https://api.deepseek.com/v1
#   EXPLABS_API_KEY=<ключ с platform.deepseek.com>
#   COURSE_MODEL=deepseek-chat
#   COURSE_MODEL_FALLBACK=deepseek-chat
